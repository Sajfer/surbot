{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate keeps every dependency current: Go modules, GitHub Actions, the Dockerfile's base images and its yt-dlp pin.",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Stockholm",
  "schedule": [
    "before 9am on monday"
  ],
  "dependencyDashboard": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "yt-dlp release pinned by ARG YTDLP_VERSION",
      "managerFilePatterns": [
        "/^build/package/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG YTDLP_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Go modules and base images change what ships, so they are fixes, like Dependabot's",
      "matchManagers": [
        "gomod",
        "dockerfile"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "One weekly PR for minor and patch Go module updates; majors stay separate",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go modules"
    },
    {
      "description": "Workflow changes are ci, grouped into one weekly PR",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "groupName": "GitHub Actions"
    },
    {
      "description": "A new yt-dlp is a fix and should not wait for Monday: YouTube changes often break old versions",
      "matchPackageNames": [
        "yt-dlp/yt-dlp"
      ],
      "semanticCommitType": "fix",
      "schedule": [
        "at any time"
      ]
    }
  ]
}
